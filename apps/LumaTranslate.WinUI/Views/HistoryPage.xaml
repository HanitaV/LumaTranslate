<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LumaTranslate_WinUI.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LumaTranslate_WinUI.ViewModels"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                AutomationProperties.AutomationId="HistorySearchBox"
                PlaceholderText="Tìm kiếm văn bản gốc hoặc bản dịch tiếng Việt..."
                TextChanged="SearchBox_TextChanged" />

            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="RefreshHistoryButton"
                Click="RefreshBtn_Click"
                Content="Làm mới" />

            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="ClearHistoryPageButton"
                Click="ClearHistoryBtn_Click"
                Content="Xóa lịch sử" />
        </Grid>

        <ListView
            Grid.Row="1"
            AutomationProperties.AutomationId="HistoryListView"
            ItemsSource="{x:Bind ViewModel.HistoryItems, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                    <StackPanel
                        Margin="0,4"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind TimestampText}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Provider}" />
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind OcrText}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind VietnameseTranslation}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
