<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LumaTranslate_WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer Padding="24,16,24,32" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" Spacing="20">

            <!-- Top Action Bar so users never miss saving -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Cài đặt dịch thuật, giọng đọc &amp; phụ đề nổi" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Nhấn 'Lưu tất cả cài đặt' sau khi thay đổi khóa API hoặc thông số bên dưới" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Click="UnlockOverlayFromSettingsBtn_Click"
                    Content="✥ Mở khóa kéo chỗ hiện Vietsub" />
                <Button
                    Grid.Column="2"
                    Click="SaveSettingsBtn_Click"
                    Content="Lưu tất cả cài đặt"
                    Style="{ThemeResource AccentButtonStyle}" />
            </Grid>

            <!-- OCR Settings -->
            <StackPanel
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Nhận dạng OCR (PaddleOCR PP-OCRv5)" />
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.OcrStatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.GpuSummaryText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="DefaultLangCombo"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="DefaultLanguageCombo"
                        Header="Ngôn ngữ gợi ý ban đầu khi tạo vùng mới (bạn vẫn tự chọn lại cho từng vùng)" />
                    <NumberBox
                        x:Name="IntervalNumberBox"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="MonitoringIntervalBox"
                        Header="Chu kỳ kiểm tra màn hình (ms)"
                        Maximum="2000"
                        Minimum="100"
                        SmallChange="50"
                        SpinButtonPlacementMode="Compact" />
                </Grid>
            </StackPanel>

            <!-- Cloud Translation Settings -->
            <StackPanel
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Dịch đám mây (Đích duy nhất: Tiếng Việt)" />

                <CheckBox
                    x:Name="CloudConsentCheckBox"
                    AutomationProperties.AutomationId="CloudConsentCheckBox"
                    Content="Tôi hiểu và đồng ý gửi văn bản nhận dạng OCR lên nhà cung cấp dịch đám mây đã chọn (không gửi hình ảnh chụp màn hình)" />

                <ComboBox
                    x:Name="ProviderCombo"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="ProviderComboBox"
                    Header="Nhà cung cấp dịch trực tuyến chính" />

                <TextBox
                    x:Name="MyMemoryEmailBox"
                    Header="Email liên hệ MyMemory (Khuyến nghị điền nếu dùng MyMemory miễn phí để tăng hạn mức gấp 10 lần)"
                    PlaceholderText="ví dụ: ban@example.com" />

                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <PasswordBox
                        x:Name="AzureKeyBox"
                        Grid.Row="0"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="AzureApiKeyBox"
                        Header="Khóa API Azure Translator (Hỗ trợ gói F0 2 triệu ký tự/tháng miễn phí)"
                        PlaceholderText="Nhập khóa đăng ký Azure Translator" />
                    <TextBox
                        x:Name="AzureRegionBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="AzureRegionBox"
                        Header="Vùng Azure (Region • Bắt buộc với khóa theo vùng)"
                        PlaceholderText="ví dụ: southeastasia" />
                    <TextBox
                        x:Name="AzureEndpointBox"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        AutomationProperties.AutomationId="AzureEndpointBox"
                        Header="Điểm cuối Azure Translator (Để trống dùng mặc định toàn cầu)"
                        PlaceholderText="https://api.cognitive.microsofttranslator.com" />
                </Grid>

                <PasswordBox
                    x:Name="GoogleKeyBox"
                    AutomationProperties.AutomationId="GoogleApiKeyBox"
                    Header="Khóa API Google Cloud Translation v2 (Tùy chọn)"
                    PlaceholderText="Nhập khóa Google Cloud Translation v2" />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="FallbackMyMemoryCheck" Content="Cho phép dự phòng sang MyMemory" />
                    <CheckBox x:Name="FallbackAzureCheck" Content="Cho phép dự phòng sang Azure (khi đã nhập khóa)" />
                    <CheckBox x:Name="FallbackGoogleCheck" Content="Cho phép dự phòng sang Google (khi đã nhập khóa)" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="TestProviderBtn"
                        AutomationProperties.AutomationId="TestProviderButton"
                        Click="TestProviderBtn_Click"
                        Content="Kiểm tra kết nối dịch API" />
                    <TextBlock
                        x:Name="TestResultText"
                        MaxWidth="640"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- TTS Settings -->
            <StackPanel
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Đọc giọng nói tiếng Việt cục bộ (VieNeu-TTS v3 Turbo)" />
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.TtsStatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <ToggleSwitch
                    x:Name="TtsAutoSwitch"
                    AutomationProperties.AutomationId="TtsAutoToggle"
                    Header="Tự động đọc bản dịch tiếng Việt"
                    OffContent="Tắt"
                    OnContent="Bật" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        x:Name="VolumeSlider"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="TtsVolumeSlider"
                        Header="Âm lượng đọc (%)"
                        Maximum="150"
                        Minimum="0"
                        StepFrequency="5" />
                    <ComboBox
                        x:Name="TtsModeCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="TtsModeComboBox"
                        Header="Thiết bị thực thi TTS" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="TestTtsBtn"
                        AutomationProperties.AutomationId="TestTtsButton"
                        Click="TestTtsBtn_Click"
                        Content="Nghe thử giọng đọc tiếng Việt" />
                    <TextBlock
                        x:Name="TestTtsResultText"
                        MaxWidth="640"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- Overlay Settings -->
            <StackPanel
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Cửa sổ phụ đề nổi (Vietsub Overlay)" />

                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="OverlayFontSizeBox"
                        Grid.Column="0"
                        Header="Cỡ chữ (pt)"
                        Maximum="56"
                        Minimum="14"
                        SpinButtonPlacementMode="Compact" />
                    <NumberBox
                        x:Name="OverlayOpacityBox"
                        Grid.Column="1"
                        Header="Độ rõ (%)"
                        Maximum="100"
                        Minimum="30"
                        SpinButtonPlacementMode="Compact" />
                    <NumberBox
                        x:Name="OverlayXBox"
                        Grid.Column="2"
                        Header="Vị trí X (px)"
                        SpinButtonPlacementMode="Compact" />
                    <NumberBox
                        x:Name="OverlayYBox"
                        Grid.Column="3"
                        Header="Vị trí Y (px)"
                        SpinButtonPlacementMode="Compact" />
                </Grid>

                <ToggleSwitch
                    x:Name="ClickThroughSwitch"
                    AutomationProperties.AutomationId="OverlayClickThroughSwitch"
                    Header="Khóa xuyên chuột (Tắt để kéo di chuyển hoặc đổi cỡ khung Vietsub trên màn hình)"
                    OffContent="Đang cho phép kéo khung Vietsub"
                    OnContent="Đang khóa xuyên chuột"
                    Toggled="ClickThroughSwitch_Toggled" />
            </StackPanel>

            <!-- Data, Environment & Uninstall Management -->
            <StackPanel
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="12">
                <TextBlock
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Quản lý dữ liệu, môi trường AI &amp; Gỡ cài đặt phần mềm" />
                <TextBlock
                    x:Name="StorageUsageSummaryText"
                    AutomationProperties.AutomationId="StorageUsageSummaryText"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Đang kiểm tra dung lượng dữ liệu và môi trường cục bộ..."
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        AutomationProperties.AutomationId="SaveSettingsButton"
                        Click="SaveSettingsBtn_Click"
                        Content="Lưu tất cả cài đặt"
                        Style="{ThemeResource AccentButtonStyle}" />

                    <Button
                        AutomationProperties.AutomationId="ClearCacheButton"
                        Click="ClearCacheBtn_Click"
                        Content="Xóa bộ nhớ đệm dịch" />

                    <Button
                        AutomationProperties.AutomationId="ClearHistoryButton"
                        Click="ClearHistoryBtn_Click"
                        Content="Xóa lịch sử hội thoại" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        AutomationProperties.AutomationId="OpenSetupWizardButton"
                        Click="OpenSetupWizardBtn_Click"
                        Content="Kiểm tra / Cài đặt lại môi trường AI" />

                    <Button
                        AutomationProperties.AutomationId="OpenAppDataFolderButton"
                        Click="OpenAppDataFolderBtn_Click"
                        Content="Mở thư mục dữ liệu cục bộ" />
                </StackPanel>

                <Border
                    Height="1"
                    Margin="0,4"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="Gỡ cài đặt LumaTranslate" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Dọn dẹp môi trường Python 3.12, mô hình AI cục bộ, dữ liệu cá nhân và tùy chọn xóa thư mục bộ cài."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="UninstallAppButton"
                        Click="UninstallAppBtn_Click"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Delete" />
                            <TextBlock Text="Gỡ cài đặt phần mềm..." />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
