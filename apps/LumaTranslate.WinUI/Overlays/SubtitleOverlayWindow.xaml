<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumaTranslate_WinUI.Overlays.SubtitleOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Phụ đề LumaTranslate">

    <Grid
        x:Name="OverlayRoot"
        Background="#DC141821"
        BorderBrush="#55FFFFFF"
        BorderThickness="1"
        CornerRadius="10"
        PointerCanceled="OverlayRoot_PointerReleased"
        PointerMoved="OverlayRoot_PointerMoved"
        PointerPressed="OverlayRoot_PointerPressed"
        PointerReleased="OverlayRoot_PointerReleased">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="DragToolbar"
            Grid.Row="0"
            Padding="14,8,10,6"
            Background="#CC0F172A"
            BorderBrush="#5538BDF8"
            BorderThickness="0,0,0,1"
            ColumnSpacing="10"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#FF7DD3FC"
                Text="✥ Giữ chuột kéo khung này để đổi chỗ Vietsub • Kéo góc phải dưới ↘ để đổi kích thước"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="LockOverlayBtn"
                Grid.Column="1"
                Padding="10,4"
                AutomationProperties.AutomationId="LockOverlayInlineButton"
                Click="LockOverlayBtn_Click"
                Content="✓ Khóa vị trí"
                FontSize="12" />
        </Grid>

        <Grid Grid.Row="1" Padding="20,12">
            <TextBlock
                x:Name="VietnameseSubtitleText"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="OverlaySubtitleTextBlock"
                FontFamily="Segoe UI Variable Display"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="#FFF8FAFC"
                LineStackingStrategy="BlockLineHeight"
                Text="Phụ đề tiếng Việt sẽ hiển thị tại đây khi bắt đầu dịch."
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <Border
            x:Name="ResizeGrip"
            Grid.RowSpan="2"
            Width="26"
            Height="26"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#990284C7"
            CornerRadius="6,0,9,0"
            PointerCanceled="ResizeGrip_PointerReleased"
            PointerMoved="ResizeGrip_PointerMoved"
            PointerPressed="ResizeGrip_PointerPressed"
            PointerReleased="ResizeGrip_PointerReleased"
            ToolTipService.ToolTip="Giữ và kéo để thay đổi kích thước khung Vietsub"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Bold"
                Foreground="#FFF8FAFC"
                Text="↘" />
        </Border>
    </Grid>
</Window>
